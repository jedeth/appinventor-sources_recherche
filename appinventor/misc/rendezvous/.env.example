# MIT App Inventor Rendezvous Server - Configuration
# ===================================================
#
# This file contains configuration examples for the rendezvous server.
# Copy this file to '.env' and adjust the values for your deployment.
#
# IMPORTANT: DO NOT commit the '.env' file to version control!
# Add '.env' to your .gitignore file.

# ============================================================
# CACHE BACKEND CONFIGURATION
# ============================================================
#
# Choose your cache backend:
# - 'memcache' : Google App Engine Memcache (original MIT implementation)
# - 'redis'    : Redis standalone (for Google-free deployment)
#
# Default: memcache
CACHE_BACKEND=redis

# ============================================================
# REDIS CONFIGURATION (only used when CACHE_BACKEND=redis)
# ============================================================

# Redis server hostname or IP address
# Default: localhost
REDIS_HOST=localhost

# Redis server port
# Default: 6379
REDIS_PORT=6379

# Redis database number (0-15)
# Default: 0
REDIS_DB=0

# Redis password (optional)
# Leave empty if your Redis server doesn't require authentication
# Example: REDIS_PASSWORD=your_secure_password_here
REDIS_PASSWORD=

# ============================================================
# DEPLOYMENT EXAMPLES
# ============================================================

# Example 1: Local development with Redis
# ----------------------------------------
# CACHE_BACKEND=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Example 2: Production with Redis on a separate server
# ------------------------------------------------------
# CACHE_BACKEND=redis
# REDIS_HOST=redis.example.com
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=secure_production_password

# Example 3: Google App Engine with Memcache (original)
# ------------------------------------------------------
# CACHE_BACKEND=memcache
# (no Redis configuration needed)

# Example 4: Docker Compose deployment
# -------------------------------------
# CACHE_BACKEND=redis
# REDIS_HOST=redis  # service name in docker-compose.yml
# REDIS_PORT=6379
# REDIS_DB=0

# ============================================================
# NOTES
# ============================================================
#
# - Both backends use a 120-second TTL for cached data
# - Redis provides better performance and scalability than Memcache
# - Redis supports persistence (RDB/AOF) if needed
# - For high availability, consider Redis Sentinel or Redis Cluster
# - The cache is used only for temporary rendezvous data, not for
#   persistent storage (that's handled by SQLite for statistics)
